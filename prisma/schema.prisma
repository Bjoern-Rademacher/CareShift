generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Department {
  ER
  ICU
  SURGERY
  RADIOLOGY
}

enum EmployeeStatus {
  ACTIVE
  DISABLED
}

enum Position {
  DOCTOR
  HEAD_DOCTOR
  SURGEON
  NURSE
  INTERN
  MEDICAL_ASSISTANT
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum PeriodStatus {
  DRAFT
  VALIDATED
  PUBLISHED
}

model Employee {
  id          String         @id @default(uuid()) @db.Uuid
  firstName   String
  lastName    String
  position    Position
  departments Department[]
  status      EmployeeStatus @default(ACTIVE)

  shiftSlots ShiftSlot[]
}

model SchedulePeriod {
  id         String     @id @default(uuid()) @db.Uuid
  department Department
  startDate  DateTime
  endDate    DateTime
  status     PeriodStatus @default(DRAFT)

  shiftSlots ShiftSlot[]

  @@unique([department, startDate])
}

model ShiftSlot {
  id String @id @default(uuid()) @db.Uuid

  periodId String         @db.Uuid
  period   SchedulePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  employeeId String?   @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  department Department
  position   Position
  slotNumber Int

  startTime DateTime
  endTime   DateTime

  @@index([periodId])
  @@index([employeeId])
  @@index([startTime])
}

model TemplateRule {
  id         String     @id @default(uuid()) @db.Uuid
  department Department
  position   Position
  weekdays   Weekday[]

  startTimeLocal String
  endTimeLocal   String

  slots  Int
  active Boolean @default(true)
}